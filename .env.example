# Server only. Copy to an untracked .env and use uvicorn --env-file .env (install python-dotenv).
# Alternatively set these with your shell/host secret manager. Never paste real keys into chat.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
CORS_ORIGINS=http://localhost:3000
INVITE_REDIRECT_URL=http://localhost:3000/auth/callback
CALENDAR_TIMEZONE=America/Denver
MAX_UPLOAD_BYTES=3000000
# Tests only: optional disposable PostgreSQL URL; no Supabase credentials are used.
# EMS_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/postgres
